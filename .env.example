# wedplan-server environment — copy to .env and fill in real values.
# .env is git-ignored; never commit real secrets.

# --- Required ---
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/
JWT_SECRET=
# Same value as the client's BETTER_AUTH_SECRET (verifies session cookies).
BETTER_AUTH_SECRET=

# --- Optional (server defaults shown) ---
PORT=8000
CLIENT_URL=http://localhost:3000
JWT_EXPIRES_IN=1h

# --- Demo seed credentials (used by scripts/seed.js) ---
# Password applied to every seeded demo account, including admin@wedplan.test.
# Must be 6+ characters with at least one uppercase and one lowercase letter.
# Re-run `node scripts/seed.js` after changing it to update existing users.
ADMIN_PASSWORD=Wedplan1!

# --- Stripe (Premium checkout) ---
# Leave empty to disable payments: checkout returns a clear 503 message.
STRIPE_SECRET_KEY=
# From the Stripe webhook endpoint settings (raw-body signature verification).
STRIPE_WEBHOOK_SECRET=

# --- ImgBB (profile image uploads) ---
# Leave empty to disable uploads: returns a clear 503 message.
IMGBB_API_KEY=

# --- UPI (vendor premium subscription) ---
# Payee UPI ID shown on the QR/deep link. Leave empty to disable UPI checkout.
UPI_VPA=wedplan@upi
UPI_PAYEE_NAME=WedPlan
# Subscription price in paise (49900 = ₹499) for 30 days.
UPI_MONTHLY_PAISE=49900
